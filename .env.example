# Copy to .env and fill in
API_HOST=0.0.0.0
API_PORT=8000
FRONTEND_URL=http://localhost:5173
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
VECTOR_STORE=tfidf
TOP_K_RETRIEVAL=3
# OPENAI_API_KEY=  # optional — RAG works offline with template grounding; set to enable LLM rerank/generation
# ANTHROPIC_API_KEY=
LLM_PROVIDER=offline-grounded
